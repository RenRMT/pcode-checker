{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": false,
    "types": ["office-js", "custom-functions-runtime"],
    "paths": {
      "@pcode-checker/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
